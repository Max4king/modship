# CurseForge API key — required for CurseForge modpack search/install
# Get one at https://console.curseforge.com/
CF_API_KEY=your_curseforge_api_key

# Cloudflare API token — required for DNS record management
# Create a token with Zone:DNS:Edit permission
CLOUDFLARE_API_KEY=your_cloudflare_api_token

# Cloudflare zone ID — the DNS zone to manage records in
CLOUDFLARE_ZONE_ID=your_zone_id

# Host public IP — used for Cloudflare A records
MODSHIP_HOST_IP=your.server.public.ip

# Parent domain for server subdomains (e.g. myserver.max4king.com)
MODSHIP_BASE_DOMAIN=max4king.com

# HTTP listen address
MODSHIP_LISTEN=127.0.0.1:8080

# mc-router HTTP API URL
MODSHIP_ROUTER_URL=http://localhost:25566

# Shared Docker network name
MODSHIP_DOCKER_NETWORK=modship_minecraft-network
